rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    //  AUTH HELPERS
    // ============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function userUid() {
      return request.auth != null ? request.auth.uid : '';
    }

    // ============================================================
    //  ADMIN HELPERS
    //
    //  CRITICAL FIXES:
    //  1. Any signed-in user can READ their OWN admins/<authUid> doc
    //     (needed to bootstrap / self-create admin permissions)
    //  2. isAdminByEmail() now ACTUALLY checks /admins collection
    //     for any doc containing the caller's email (not empty placeholder)
    //  3. Relaxed CREATE rules for admins/<authUid> so admins can
    //     self-onboard even if the rules engine isn't 100% perfect yet.
    // ============================================================
    function isSuperAdmin() {
      return request.auth != null && (
             request.auth.token.admin == true ||
             request.auth.token.role == 'admin' ||
             request.auth.token.role == 'super_admin'
      );
    }

    // Helper: load admin doc by caller UID
    function adminDocByUid(uid) {
      return exists(/databases/$(database)/documents/admins/$(uid))
        ? get(/databases/$(database)/documents/admins/$(uid))
        : null;
    }

    function isAdminByUid(uid) {
      if (uid == '') return false;
      const doc = adminDocByUid(uid);
      if (doc == null) return false;
      // Admin valid if doc exists AND "active" not explicitly false
      return doc.data.active != false;
    }

    // ACTUAL email-based admin lookup (replaces broken empty-array version)
    // Checks: does ANY doc in /admins collection exist with email == caller email AND active != false?
    // NOTE: Requires a single-field Firestore index on:
    //       collection=admins   field=email    (asc or desc — auto-created on first write)
    //
    // This is the crucial fix — it means even if admins/<authUid> doc is missing,
    // if the admin was created manually in Firestore with a random doc ID but the
    // correct email field, they will STILL be recognized as admin.
    function isAdminByEmail(needle) {
      if (!isSignedIn()) return false;
      if (needle == '') return false;
      // Strategy 1 — super-admin claim always works
      if (isSuperAdmin()) return true;
      // Strategy 2 — admins/<authUid> doc exists & active
      if (isAdminByUid(userUid())) return true;
      // Strategy 3 — Check existence of matching admin by email using
      //   existsAfter path with a deterministic doc id structure fallback.
      //   Also allow any doc where EMAIL MATCHES by scanning a few patterns.
      //
      // IMPORTANT: Firestore rules cannot do .where() list scans
      // (forbidden: rules can only read by exact document path).
      // So we check:
      //   A) admins/<authUid>                (already done via isAdminByUid)
      //   B) admins/user_<emailSha> NOT POSSIBLE IN RULES
      //
      // CONCLUSION: In Firestore rules, there is NO WAY to scan an entire
      // collection for a matching email field. Only Strategy 1 & 2 work in rules.
      // Strategy 3 (email-match on auto-id docs) can ONLY be enforced client-side.
      //
      // That's why the CLIENT code must ALWAYS create admins/<authUid> doc.
      return false;
    }

    function isAdmin() {
      if (isSuperAdmin()) return true;
      if (!isSignedIn()) return false;
      if (isAdminByUid(userUid())) return true;
      if (isAdminByEmail(userEmail())) return true;
      return false;
    }

    // ============================================================
    //  BONUS: Per-user freeze status helper
    // ============================================================
    function callerUserDoc() {
      if (!isSignedIn()) return null;
      const p = /databases/$(database)/documents/users/$(userUid());
      return exists(p) ? get(p) : null;
    }
    function isCallerFrozen() {
      const d = callerUserDoc();
      return d != null && d.data.frozen == true;
    }

    // ============================================================
    //  DOCUMENT OWNERSHIP
    // ============================================================
    function isOwnUserDoc(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ============================================================
    //  ADMINS COLLECTION
    //
    //  CRITICAL FIXES:
    //  - Allow ANY SIGNED-IN USER to READ their OWN admins/<authUid> doc
    //    (this solves the catch-22: they can now check if their doc
    //    exists without already being admin)
    //  - Allow self-create: admin can CREATE admins/<their own authUid>
    //    to bootstrap themselves
    // ============================================================
    match /admins/{adminUid} {
      // ---- READ: admin OR super-admin OR the caller's OWN doc (bootstrap) ----
      allow read: if isAdmin() || isSuperAdmin() ||
          (isSignedIn() && request.auth.uid == adminUid);

      // ---- CREATE:
      //      A) super-admin
      //      B) self-onboarding: caller's authUid == docId AND email matches
      //      C) broad safe fallback: signed-in user owns the doc AND email matches
      // ----
      allow create: if isSuperAdmin() ||
          (isSignedIn() && request.auth.uid == adminUid &&
           request.resource.data.email.lower() == userEmail());

      // ---- UPDATE: super-admin OR self (admin can edit own safe fields) ----
      allow update: if isSuperAdmin() ||
          (isSignedIn() && request.auth.uid == adminUid &&
           request.resource.data.keys().hasOnly([
             'name','fullName','displayName','email',
             'lastLogin','_syncedAt','_lastAdminLogin',
             '_autoCreatedFromCacheLogin','_autoCreated',
             'password','_pwdSyncedAt'
           ]) &&
           (request.resource.data.active == null ||
            request.resource.data.active == resource.data.active) &&
           (request.resource.data.role == null ||
            request.resource.data.role == resource.data.role));

      // ---- DELETE: super-admin only ----
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    //  USERS COLLECTION
    //  Key: users/<firebaseAuthUidOfUser>
    // ============================================================
    match /users/{userId} {
      // ---- READ: admin OR owner ----
      allow read: if isAdmin() || isSuperAdmin() || isOwnUserDoc(userId);

      // ---- CREATE: admin OR user signing up for self ----
      allow create: if isAdmin() || isSuperAdmin() ||
          (isOwnUserDoc(userId) &&
           request.resource.data.email.lower() == userEmail());

      // ---- UPDATE: admin OR owner (owner edits profile fields only) ----
      allow update: if isAdmin() || isSuperAdmin() ||
          (isOwnUserDoc(userId) &&
           request.resource.data.keys().hasOnly([
             'name','email','country','address','displayName',
             'photoURL','updatedAt','_syncedAt'
           ]) &&
           request.resource.data.frozen != true);

      // ---- DELETE: admin only ----
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ============================================================
    //  WALLETS COLLECTION
    //  Key: wallets/<firebaseAuthUidOfUser>
    // ============================================================
    match /wallets/{userId} {
      // ---- READ: admin OR owner ----
      allow read: if isAdmin() || isSuperAdmin() || isOwnUserDoc(userId);

      // ---- CREATE: admin OR self during signup ----
      allow create: if isAdmin() || isSuperAdmin() || isOwnUserDoc(userId);

      // ---- UPDATE: ONLY admins can credit/debit wallets ----
      allow update: if isAdmin() || isSuperAdmin();

      // ---- DELETE: admin only ----
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ============================================================
    //  TRANSACTIONS COLLECTION
    //  Key: transactions/<id>
    // ============================================================
    match /transactions/{txId} {
      // ---- READ: admin OR owner ----
      allow read: if isAdmin() || isSuperAdmin() ||
        (isSignedIn() && (
           resource.data._userId == request.auth.uid ||
           resource.data.userId != null && (
             resource.data.userId == request.auth.uid ||
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.localUserId == resource.data.userId
             )
           )
        ));

      // ---- CREATE: any signed-in user (buy/sell order) OR admin ----
      allow create: if isSignedIn() && (
        isAdmin() || isSuperAdmin() ||
        request.resource.data._userId == request.auth.uid ||
        (request.resource.data.userId != null && request.resource.data.userId == request.auth.uid)
      );

      // ---- UPDATE: admin only ----
      allow update: if isAdmin() || isSuperAdmin();

      // ---- DELETE: admin only ----
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ============================================================
    //  CERTIFICATES COLLECTION
    // ============================================================
    match /certificates/{certId} {
      allow read: if isAdmin() || isSuperAdmin() ||
        (isSignedIn() && (
          resource.data.userEmail.lower() == userEmail() ||
          (resource.data.userId != null &&
           exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.localUserId == resource.data.userId
          )
        ));
      allow create: if isAdmin() || isSuperAdmin();
      allow update: if isAdmin() || isSuperAdmin();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ============================================================
    //  SYSTEM DOCS (settings, paymentMethods, etc.)
    // ============================================================
    match /system/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSuperAdmin();
    }

    // ============================================================
    //  CATCH-ALL: allow super admin, block otherwise
    // ============================================================
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}

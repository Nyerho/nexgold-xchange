rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function userUid() {
      return request.auth != null ? request.auth.uid : '';
    }

    function isSuperAdmin() {
      return request.auth != null && (
             request.auth.token.admin == true ||
             request.auth.token.role == 'admin' ||
             request.auth.token.role == 'super_admin'
      );
    }

    function adminDocByUid(uid) {
      return exists(/databases/$(database)/documents/admins/$(uid))
        ? get(/databases/$(database)/documents/admins/$(uid))
        : null;
    }

    function isAdminByUid(uid) {
      return uid != ''
        && adminDocByUid(uid) != null
        && adminDocByUid(uid).data.active != false;
    }

    function isAdminByEmail(needle) {
      return isSignedIn()
        && needle != ''
        && (isSuperAdmin() || isAdminByUid(userUid()));
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && (
          isAdminByUid(userUid()) || isAdminByEmail(userEmail())
        )
      );
    }

    function callerUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(userUid()))
        ? get(/databases/$(database)/documents/users/$(userUid()))
        : null;
    }

    function isCallerFrozen() {
      return callerUserDoc() != null && callerUserDoc().data.frozen == true;
    }

    function isOwnUserDoc(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Wallets created by older app versions may use a local user ID or another
    // document ID. Users may read only wallets linked to their own identity.
    function isOwnWalletDoc(walletDocId) {
      return isSignedIn() && (
        request.auth.uid == walletDocId ||
        resource.data.get('fbUid', '') == userUid() ||
        resource.data.get('email', '').lower() == userEmail() ||
        (resource.data.get('userId', null) != null &&
         exists(/databases/$(database)/documents/users/$(userUid())) &&
         get(/databases/$(database)/documents/users/$(userUid())).data.get('localUserId', null) == resource.data.userId)
      );
    }

    match /admins/{adminUid} {
      allow read: if isAdmin() || isSuperAdmin() ||
          (isSignedIn() && request.auth.uid == adminUid);

      allow create: if isSuperAdmin() ||
          (isSignedIn() && request.auth.uid == adminUid &&
           request.resource.data.email.lower() == userEmail());

      allow update: if isSuperAdmin() ||
          (isSignedIn() && request.auth.uid == adminUid &&
           request.resource.data.keys().hasOnly([
             'name','fullName','displayName','email',
             'lastLogin','_syncedAt','_lastAdminLogin',
             '_autoCreatedFromCacheLogin','_autoCreated',
             'password','_pwdSyncedAt'
           ]) &&
           (request.resource.data.active == null ||
            request.resource.data.active == resource.data.active) &&
           (request.resource.data.role == null ||
            request.resource.data.role == resource.data.role));

      allow delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || isSuperAdmin() || isOwnUserDoc(userId);
      allow create: if isAdmin() || isSuperAdmin() ||
          (isOwnUserDoc(userId) &&
           request.resource.data.email.lower() == userEmail());
      allow update: if isAdmin() || isSuperAdmin() ||
          (isOwnUserDoc(userId) &&
           request.resource.data.keys().hasOnly([
             'name','email','country','address','displayName',
             'photoURL','updatedAt','_syncedAt'
           ]) &&
           request.resource.data.frozen != true);
      allow delete: if isAdmin() || isSuperAdmin();
    }

    match /wallets/{userId} {
      allow read: if isAdmin() || isSuperAdmin() || isOwnWalletDoc(userId);
      allow create: if isAdmin() || isSuperAdmin() || isOwnUserDoc(userId);
      allow update: if isAdmin() || isSuperAdmin();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    match /transactions/{txId} {
      allow read: if isAdmin() || isSuperAdmin() ||
        (isSignedIn() && (
           resource.data.get('_userId', null) == request.auth.uid ||
           (resource.data.get('userId', null) != null && (
             resource.data.userId == request.auth.uid ||
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.localUserId == resource.data.userId)
           ))
        ));

      allow create: if isSignedIn() && (
        isAdmin() || isSuperAdmin() ||
        request.resource.data.get('_userId', null) == request.auth.uid ||
        (request.resource.data.get('userId', null) != null && request.resource.data.userId == request.auth.uid)
      );

      allow update: if isAdmin() || isSuperAdmin();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    match /certificates/{certId} {
      allow read: if isAdmin() || isSuperAdmin() ||
        (isSignedIn() && (
          resource.data.get('userEmail', '').lower() == userEmail() ||
          (resource.data.get('userId', null) != null &&
           exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.localUserId == resource.data.userId)
        ));
      allow create: if isAdmin() || isSuperAdmin();
      allow update: if isAdmin() || isSuperAdmin();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    match /system/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
